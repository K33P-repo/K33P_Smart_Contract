# K33P NOK — deploy/admin CLI environment.
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# The CLI reads secrets from the environment ONLY — it never prompts for or
# prints the wallet seed. Load this file with the npm scripts (which pass
# --env-file-if-exists=.env) or directly: `node --env-file=.env ...`.
#
# Full mainnet runbook: ./deploymain.md

# ── Target network ───────────────────────────────────────────────────────────
# One of: preview (default) | preprod | standalone | mainnet
MIDNIGHT_NETWORK=preview

# ── Wallet (REQUIRED) ────────────────────────────────────────────────────────
# Hex seed of the funded wallet. KEEP SECRET. A leaked seed = stolen funds.
# On mainnet this wallet pays all fees in DUST and must already hold spendable DUST.
WALLET_SEED=

# ── Admin secret (optional) ──────────────────────────────────────────────────
# Hex 32-byte secret that controls the contract. It gates BOTH the NOK circuits
# (register/approve) AND the identity circuits (register_identity/verify_login) —
# they live on the SAME deployed contract, so there is only one address and one
# admin secret. If unset at deploy time one is generated and printed ONCE — save
# it. Required by `admin`.
# NOK_ADMIN_SECRET=

# ── Proof server (REQUIRED for every deploy — generates the ZK proof) ─────────
# Must be reachable: `curl $MIDNIGHT_PROOF_SERVER_URL/health` -> {"status":"ok"}
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# ── MAINNET ONLY (via Blockfrost; official mainnet indexer/RPC are offline) ───
# Per-network Blockfrost token — create a Midnight *Mainnet* project at blockfrost.io.
# A preprod/preview token 403s on mainnet.
# MIDNIGHT_BLOCKFROST_PROJECT_ID=
# Mainnet is irreversible and spends REAL funds — deploy.ts refuses without this:
# CONFIRM_MAINNET_DEPLOY=yes

# ── Deployed contract address (written by deploy.ts; wire your app to it) ─────
# Mainnet:            MIDNIGHT_MAIN_NOK_ADDRESS=...
# preview/preprod:    MIDNIGHT_NOK_ADDRESS=...

# ── Wallet sync-state persistence (optional) ─────────────────────────────────
# Set to 1 to ignore/clear saved sync snapshots and re-sync from genesis.
# WALLET_STATE_RESET=1
