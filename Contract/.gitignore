# Dependencies
node_modules/

# Build output
dist/

# Runtime / logs
logs/
*.log

# Deployment secrets (contains adminSecret — DO NOT COMMIT)
nok-deployment.json
nok-deployment*.json

# Environment / secrets — contains WALLET_SEED and the Blockfrost token
.env
.env.*
!.env.example

# Wallet sync-state snapshots (seed-derived; never commit)
.wallet-state/

# Private state stores created by the CLI
*-private-state/
*-level-db/
midnight-level-db/

# Compiled ZK assets are generated by `npm run compact`.
# managed/nok is the EXACT build deployed to mainnet (verifier keys must match
# the chain byte-for-byte) and is committed as a release artefact — do NOT
# recompile it. Everything else under managed/ is regenerated locally.
contract/src/managed/*
!contract/src/managed/nok/
