# K33P backend environment.
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# In production, source these from a secret manager, not a file.

# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRATION=24h

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Either DATABASE_URL, or the individual DB_* vars below.
# DATABASE_URL=postgres://user:pass@host:5432/k33p_database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=k33p_database
DB_USER=postgres
# REQUIRED in production (no insecure default is used there).
DB_Password=

# ── Database TLS ──────────────────────────────────────────────────────────────
# In production TLS is verified by default. Provide a CA for private/self-signed
# certs; only disable verification if you fully understand the MITM risk.
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# ── At-rest encryption (pgcrypto) — see DB-ENCRYPTION.md ──────────────────────
# Both >= 32 chars. Losing DB_ENCRYPTION_KEY makes encrypted data unrecoverable.
DB_ENCRYPTION_KEY=
DB_BLIND_INDEX_KEY=

# ── Seed-phrase encryption (AES-256-GCM) ──────────────────────────────────────
# >= 32 chars. Server-held master secret; NOT the public userId.
SEED_PHRASE_ENCRYPTION_KEY=

# ── Midnight identity contract (real ZK for signup/login) ─────────────────────
# The backend is the admin/off-chain client of the deployed Compact contract
# that holds BOTH the NOK and identity registries (one address, one admin).
# preview | preprod | standalone | mainnet
MIDNIGHT_NETWORK=preview
# Deployed contract address (from the deploy CLI). Use the mainnet form on prod.
NOK_CONTRACT_ADDRESS=
# 32-byte hex admin secret controlling the contract (register/verify).
NOK_ADMIN_SECRET=
# Hex seed of the funded operator wallet (pays DUST fees for every write).
NOK_WALLET_SEED=
# Proof server used to generate ZK proofs. Must be reachable from the backend.
PROOF_SERVER_URL=http://127.0.0.1:6300
# Mainnet only (Blockfrost): required when MIDNIGHT_NETWORK=mainnet.
# MIDNIGHT_BLOCKFROST_PROJECT_ID=
